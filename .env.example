# Copy to .env and fill in. Real environment variables always override this file.

# development | production   (default: production)
APP_ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public URL of the site (no trailing slash). Used for canonical URL, robots.txt, sitemap.xml.
SITE_URL=

# Set to true when running behind nginx / a load balancer / a PaaS router so the
# real client IP and https scheme are used (rate limiting, secure cookies, HSTS).
TRUST_PROXY=false

# Where enquiries are stored (SQLite). Defaults to instance/valora.sqlite3
# (on Vercel: /tmp, which is temporary -- see README "Deploying to Vercel").
DATABASE_PATH=

# --- Contact details shown on the page -------------------------------------
CONTACT_EMAIL=hello@valoradigital.example
# Digits only, international format without "+", e.g. 2348012345678
WHATSAPP_NUMBER=000000000000

# --- Footer social links (leave blank to keep a "#" placeholder) -------------
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=
SOCIAL_LINKEDIN=
SOCIAL_X=

# --- Contact form protection --------------------------------------------------
# At most this many valid submissions per visitor IP within the window (seconds)
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=3600

# --- Optional: e-mail alert for each new enquiry -------------------------------
# Enquiries are always saved to the database; e-mail is sent only if both
# MAIL_SERVER and MAIL_RECIPIENT are set.
# On Vercel and other serverless hosts the e-mail is the ONLY reliable record of an
# enquiry, so it is required there: without it the form refuses submissions.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_RECIPIENT=
